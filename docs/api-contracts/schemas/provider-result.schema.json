{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerozap.com.br/schemas/v1/provider-result.schema.json",
  "title": "ProviderResult",
  "description": "Resposta de um provedor. Falha é resultado, não exceção.",
  "type": "object",
  "required": [
    "provider",
    "status",
    "checkedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "OK",
        "EMPTY",
        "PARTIAL",
        "ERROR",
        "TIMEOUT",
        "RATE_LIMITED",
        "UNAUTHORIZED"
      ]
    },
    "offers": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "flight-offer.schema.json"
      }
    },
    "message": {
      "type": [
        "string",
        "null"
      ],
      "description": "Diagnóstico. Nunca texto de interface."
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "OK"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "offers": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": [
          "offers"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "EMPTY",
              "ERROR",
              "TIMEOUT"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "offers": {
            "type": [
              "array",
              "null"
            ],
            "maxItems": 0
          }
        }
      }
    }
  ]
}
