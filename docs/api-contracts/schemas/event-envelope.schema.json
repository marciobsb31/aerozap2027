{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerozap.com.br/schemas/v1/event-envelope.schema.json",
  "title": "EventEnvelope",
  "description": "Envelope de todo evento publicado pelo Outbox.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Chave de idempotência dos consumidores."
    },
    "eventType": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z-]+)+$"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "aggregateId": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "string",
      "description": "JSON do payload do evento, como texto."
    }
  }
}
