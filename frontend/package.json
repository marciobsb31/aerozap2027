    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "angular-eslint": "22.6.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
