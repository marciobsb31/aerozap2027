# AeroZap — variáveis de ambiente (EXEMPLO)
# Copie para .env e preencha. O arquivo .env NUNCA é versionado.
# Este arquivo contém apenas nomes e valores fictícios.

# --- Perfil ---
SPRING_PROFILES_ACTIVE=local

# --- Banco de dados (PostgreSQL) — definidos na AZ-011 ---
POSTGRES_HOST=localhost
# 15432 evita conflito com PostgreSQL local e portas reservadas do Windows
POSTGRES_PORT=15432
POSTGRES_DB=aerozap
POSTGRES_USER=aerozap
POSTGRES_PASSWORD=troque-esta-senha-local

# --- Mensageria (RabbitMQ) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=aerozap
RABBITMQ_PASSWORD=troque-esta-senha-local

# --- Cache (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=troque-esta-senha-local

# --- Armazenamento de objetos (S3 compatível; RustFS local) ---
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=aerozap
S3_SECRET_KEY=troque-esta-senha-local

# --- Provedores de voos (só em desenvolvimento e teste) ---
# SerpApi (Google Flights): usado apenas para validar com dados reais; não é fonte de produção.
SERPAPI_API_KEY=
# Travelpayouts (Aviasales Data API)
TRAVELPAYOUTS_TOKEN=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- IA: LLM e transcrição de áudio (defina também o teto mensal de gasto) ---
LLM_API_KEY=
STT_API_KEY=

# --- Gateway de pagamento (sandbox) ---
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Ambiente de desenvolvimento (opcional)
# ---------------------------------------------------------------------------
# Repositório local do Maven. Vazio = padrão do Maven (~/.m2/repository, no disco do sistema).
# Defina para manter o cache de dependências no mesmo disco do projeto. Use barras normais.
# Exemplo no Windows: D:/Aerozap-dev/maven-repo
MAVEN_REPO_LOCAL=
