# AeroZap — variáveis de ambiente (EXEMPLO)
# Copie para .env e preencha. O arquivo .env NUNCA é versionado.
# Este arquivo contém apenas nomes e valores fictícios.

# --- Perfil ---
SPRING_PROFILES_ACTIVE=local

# --- Banco de dados (PostgreSQL) — definidos na AZ-011 ---
POSTGRES_HOST=localhost
# 15432 evita conflito com PostgreSQL local e portas reservadas do Windows
POSTGRES_PORT=15432
POSTGRES_DB=aerozap
POSTGRES_USER=aerozap
POSTGRES_PASSWORD=troque-esta-senha-local

# --- Mensageria (RabbitMQ) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=aerozap
RABBITMQ_PASSWORD=troque-esta-senha-local

# --- Cache (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=troque-esta-senha-local

# --- Armazenamento de objetos (S3 compatível; RustFS local) ---
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=aerozap
S3_SECRET_KEY=troque-esta-senha-local

# --- Provedores de voos (só em desenvolvimento e teste) ---
# SerpApi (Google Flights): usado apenas para validar com dados reais; não é fonte de produção.
SERPAPI_API_KEY=
# Travelpayouts (Aviasales Data API)
TRAVELPAYOUTS_TOKEN=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- IA: LLM e transcrição de áudio (defina também o teto mensal de gasto) ---
LLM_API_KEY=
STT_API_KEY=

# --- Gateway de pagamento (sandbox) ---
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Ambiente de desenvolvimento (opcional)
# ---------------------------------------------------------------------------
# Repositório local do Maven. Vazio = padrão do Maven (~/.m2/repository, no disco do sistema).
# Defina para manter o cache de dependências no mesmo disco do projeto. Use barras normais.
# Exemplo no Windows: D:/Aerozap/.cache/maven-repo (fica dentro do projeto, já ignorado pelo Git)
MAVEN_REPO_LOCAL=
# Cache do npm (front-end, a partir da AZ-016). Vazio = padrão do npm, no disco do sistema.
NPM_CONFIG_CACHE=

# ---------------------------------------------------------------------------
# Observabilidade local (AZ-013) — opcional, sobe com scripts/obs-up.sh
# ---------------------------------------------------------------------------
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
GRAFANA_USER=aerozap
GRAFANA_PASSWORD=troque-esta-senha-local
LOKI_PORT=3100
TEMPO_PORT=3200
TEMPO_OTLP_HTTP_PORT=4318
RABBITMQ_PROMETHEUS_PORT=15692
# Endereços usados pelos serviços Java (rodam na máquina, fora do Docker).
OTLP_TRACES_URL=http://localhost:4318/v1/traces
LOKI_URL=http://localhost:3100/loki/api/v1/push
TRACING_AMOSTRAGEM=1.0

# ---------------------------------------------------------------------------
# API Gateway (AZ-015)
# ---------------------------------------------------------------------------
# Porta da borda. O platform-core usa 8081 (SERVER_PORT do próprio serviço).
GATEWAY_PORT=8080
# Validação do token de entrada. Fase 1: segredo compartilhado (HS256), mínimo de 32 caracteres.
# Com o serviço de identidade (AZ-020) isto vira o endereço do conjunto de chaves públicas.
JWT_SECRET=troque-por-um-segredo-de-32-caracteres-ou-mais
JWT_EMISSOR=https://aerozap.local/identidade
JWT_PUBLICO=aerozap-api
# Limite de taxa na borda (proteção de infraestrutura, não franquia de plano).
LIMITE_HABILITADO=true
LIMITE_REQUISICOES=120
LIMITE_JANELA=1m
# Destino das rotas. O prefixo da borda sai e o resto do caminho vai para este endereço.
DESTINO_PLATFORM_CORE=http://localhost:8081/api
